# Independent Mini App API — NEVER point this at the Telegram bot apex_game.db
MINIAPP_DATABASE_URL=sqlite+aiosqlite:///./data/bayhan_miniapp.db

# Required in production (>= 32 random chars). Dev has a fallback.
MINIAPP_JWT_SECRET=replace-with-long-random-secret-value-here

# Comma-separated browser origins allowed by CORS
MINIAPP_CORS_ORIGINS=http://localhost:3000,http://localhost:4173,https://apex3488.github.io

MINIAPP_STARTING_BALANCE_USD=50000
MINIAPP_CRASH_MIN_BET=1
# Max bet is wallet balance only (MINIAPP_CRASH_MAX_BET ignored if present).


# One-time secret to create the first admin via POST /api/admin/bootstrap
# Remove or rotate after the first admin exists.
MINIAPP_ADMIN_BOOTSTRAP_SECRET=

MINIAPP_AUTH_RATE_LIMIT=20
