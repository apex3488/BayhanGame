# Скопируйте в .env.local для локальной разработки.
# Все NEXT_PUBLIC_* переменные попадают в публичный JavaScript-бандл.
# НИКОГДА не помещайте сюда BOT_TOKEN, service_role key или другие секреты.

# Имя Telegram-бота БЕЗ символа @. Нужно для кнопки «Вернуться в бот» и реферальных ссылок.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Источник данных: demo | supabase | api
#   demo     — единственный режим с песочницей. Для локального UI-превью.
#   supabase — LIVE: публичный каталог + Edge Function. Без Telegram initData
#              демопрофиль НЕ подставляется — показывается «Нет подключения».
#   api      — LIVE: FastAPI Mini App API рядом с Python-ботом (GET /health, GET /api/me).
NEXT_PUBLIC_DATA_SOURCE=api

# Supabase (только публичный anon/publishable key — RLS обязателен)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Имя Supabase Edge Function (DATA_SOURCE=supabase)
NEXT_PUBLIC_SUPABASE_FUNCTION_NAME=miniapp-api

# Базовый URL FastAPI backend (DATA_SOURCE=api), без завершающего /
# Пример туннеля: https://xxxx.trycloudflare.com
NEXT_PUBLIC_GAME_API_URL=https://bind-solomon-components-heavy.trycloudflare.com

# Подпуть публикации. Локально пусто. В GitHub Actions — автоматически.
NEXT_PUBLIC_BASE_PATH=
